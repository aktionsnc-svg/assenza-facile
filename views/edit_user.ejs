            <!DOCTYPE html>
            <html lang="it">

            <head>
              <meta charset="UTF-8">
              <meta name="viewport" content="width=device-width, initial-scale=1.0">

              <title>I miei dati</title>

              <style>

                body {
                  font-family: "Segoe UI", sans-serif;
                  margin: 0;
                  padding: 20px;
                  background: #f6f8f9;
                }

                .card {
                  background: white;
                  border-radius: 15px;
                  padding: 24px;
                  box-shadow: 0 2px 10px rgba(0,0,0,.08);
                  max-width: 500px;
                  margin: 30px auto;
                }

                h1 {
                  text-align: center;
                  color: #14532d;
                  margin-bottom: 25px;
                }

                .description {
                  color: #666;
                  font-size: 0.95rem;
                  margin-bottom: 20px;
                  text-align: center;
                }

                label {
                  display: block;
                  margin-top: 16px;
                  font-weight: 600;
                  color: #333;
                }

                input,
                select {
                  width: 100%;
                  box-sizing: border-box;
                  padding: 10px;
                  margin-top: 6px;
                  border: 1px solid #ccc;
                  border-radius: 7px;
                  font-size: 1rem;
                }

                input:focus,
                select:focus {
                  outline: none;
                  border-color: #198754;
                }

                .readonly {
                  background: #f1f3f5;
                  color: #666;
                }

                .separator {
                  border-top: 1px solid #e5e7eb;
                  margin: 25px 0 5px;
                }

                .password-title {
                  color: #14532d;
                  font-weight: 700;
                  margin-top: 20px;
                  margin-bottom: 5px;
                }

                .password-info {
                  color: #777;
                  font-size: 0.9rem;
                  margin-bottom: 10px;
                }

                .error {
                  background: #fee2e2;
                  color: #991b1b;
                  border-radius: 8px;
                  padding: 10px;
                  margin-bottom: 15px;
                  text-align: center;
                }

                .save-btn {
                  background: #198754;
                  color: white;
                  border: none;
                  border-radius: 8px;
                  padding: 11px 18px;
                  cursor: pointer;
                  margin-top: 22px;
                  width: 100%;
                  font-size: 1rem;
                  font-weight: 600;
                }

                .save-btn:hover {
                  background: #157347;
                }

                .back {
                  text-align: center;
                  margin-top: 20px;
                }

                .back a {
                  color: #198754;
                  text-decoration: none;
                  font-weight: 600;
                }

              </style>

            </head>

            <body>

              <div class="card">

                <h1>👤 I miei dati</h1>

                <p class="description">
                  Puoi aggiornare i tuoi dati e la categoria dell'atleta.
                </p>


                <% if (error) { %>

                  <div class="error">
                    <%= error %>
                  </div>

                <% } %>


                <form
                  method="POST"
                  action="/parent/<%= encodeURIComponent(user.email) %>/edit"
                >


                  <!-- NOME -->

                  <label>
                    Nome genitore / atleta

                    <input
                      type="text"
                      name="name"
                      value="<%= user.name %>"
                      required
                    >

                  </label>


                  <!-- EMAIL -->

                  <label>
                    Email

                    <input
                      type="email"
                      value="<%= user.email %>"
                      class="readonly"
                      disabled
                    >

                  </label>


                  <!-- FIGLIO -->

                  <label>
                    Nome figlio/a

                    <input
                      type="text"
                      name="childName"
                      value="<%= user.childName %>"
                      required
                    >

                  </label>


                  <!-- CATEGORIA -->

                  <label>
                    Categoria

                    <select
                      name="category"
                      required
                    >

                      <option value="">
                        -- Seleziona categoria --
                      </option>

                      <% categories.forEach(c => { %>

                        <option
                          value="<%= c.name %>"
                          <%= c.name === user.category ? "selected" : "" %>
                        >
                          <%= c.name %>
                        </option>

                      <% }) %>

                    </select>

                  </label>


                  <div class="separator"></div>


                  <!-- CAMBIO PASSWORD -->

                  <div class="password-title">
                    🔑 Cambio password
                  </div>

                  <div class="password-info">
                    Lascia vuota la nuova password se non vuoi modificarla.
                  </div>


                  <label>
                    Nuova password

                    <input
                      type="password"
                      name="newPassword"
                      autocomplete="new-password"
                    >

                  </label>


                  <!-- VERIFICA PASSWORD -->

                  <div class="separator"></div>

                  <label>
                    Password attuale

                    <input
                      type="password"
                      name="currentPassword"
                      autocomplete="current-password"
                      required
                    >

                  </label>

                  <div class="password-info">
                    Inserisci la password attuale per confermare le modifiche.
                  </div>


                  <button
                    type="submit"
                    class="save-btn"
                  >
                    💾 Salva modifiche
                  </button>

                </form>


                <div class="back">

                  <a
                    href="/parent/<%= encodeURIComponent(user.email) %>"
                  >
                    ⬅️ Torna alla dashboard
                  </a>

                </div>

              </div>

            </body>

            </html>