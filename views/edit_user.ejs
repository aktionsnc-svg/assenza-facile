<!DOCTYPE html>
<html lang="it">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Modifica utente</title>

  <style>

    body {
      font-family: "Segoe UI", sans-serif;
      margin: 40px;
      background: #f4f6f8;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 2px 6px rgba(0,0,0,.1);
      max-width: 500px;
      margin: auto;
    }

    h1 {
      text-align: center;
      color: #004aad;
    }

    label {
      display: block;
      margin-top: 15px;
      font-weight: 600;
    }

    input,
    select {
      width: 100%;
      box-sizing: border-box;
      padding: 9px;
      margin-top: 5px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    button {
      background: #004aad;
      color: white;
      border: none;
      border-radius: 5px;
      padding: 10px 18px;
      cursor: pointer;
      margin-top: 20px;
      width: 100%;
    }

    button:hover {
      background: #0062e0;
    }

    a {
      color: #004aad;
      text-decoration: none;
    }

  </style>

</head>

<body>

  <div class="card">

    <h1>Modifica utente</h1>

    <form
      method="POST"
      action="/admin/user/edit/<%= encodeURIComponent(user.email) %>"
    >

      <label>
        Nome genitore / atleta

        <input
          type="text"
          name="name"
          value="<%= user.name %>"
          required
        >
      </label>


      <label>
        Email

        <input
          type="email"
          value="<%= user.email %>"
          disabled
        >
      </label>


      <label>
        Nome figlio/a

        <input
          type="text"
          name="childName"
          value="<%= user.childName %>"
          required
        >
      </label>


      <label>
        Categoria

        <select
          name="category"
          required
        >

          <% categories.forEach(c => { %>

            <option
              value="<%= c.name %>"
              <%= c.name === user.category ? "selected" : "" %>
            >
              <%= c.name %>
            </option>

          <% }) %>

        </select>

      </label>


      <button type="submit">
        💾 Salva modifiche
      </button>

    </form>


    <p style="text-align:center;margin-top:20px;">

      <a href="/admin">
        ⬅️ Torna alla dashboard
      </a>

    </p>

  </div>

</body>

</html>